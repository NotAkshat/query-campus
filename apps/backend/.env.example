# Server
PORT=3001
# Website address(es) allowed to call the API, comma separated. Set this in production, e.g. https://your-site.com
CORS_ORIGIN=
# Questions allowed per visitor per minute (0 = no limit). Protects your API keys.
RATE_LIMIT_PER_MINUTE=20
# Set to 1 when the app runs behind one proxy (Render, Railway, Nginx), so the real visitor address is used.
TRUST_PROXY=0

# Scraper
SCRAPE_BASE_URL=https://www.ietdavv.edu.in/
SCRAPE_MAX_PAGES=600

# Gemini (answer generation) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Lite models start streaming in ~1s; the bigger Flash models were taking 30-50s under load
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# minimal | low | medium | high (lower = faster; empty = model default)
GEMINI_THINKING_LEVEL=minimal

# Voyage AI (embeddings) — https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_DIMENSION=1024

# Pinecone (vector store) — https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=query-campus

# Indexing speed. Defaults suit Voyage's free plan. With a payment method on Voyage, try 64 and 0.
EMBED_BATCH_SIZE=5
EMBED_BATCH_DELAY_MS=21000
